{
    "model_type": "ensemble",
    "version": "1.0.0",
    "created_at": "2023-10-13",
    "components": [
        "lightgbm",
        "xgboost"
    ],
    "features": {
        "text_features": true,
        "category_features": true,
        "image_features": true,
        "numeric_features": true
    },
    "preprocessing": {
        "text_preprocessing": "nltk + tf-idf",
        "image_preprocessing": "color histograms + edge detection",
        "target_transformation": "log"
    },
    "performance": {
        "smape": 0.1409,
        "rmse": 14.23,
        "mae": 8.76
    },
    "hyperparameters": {
        "learning_rate": 0.05,
        "max_depth": 8,
        "num_leaves": 31,
        "n_estimators": 500
    },
    "dependencies": {
        "python": ">=3.8",
        "lightgbm": ">=3.3.0",
        "xgboost": ">=1.6.0",
        "sklearn": ">=1.0.0",
        "pandas": ">=1.3.0",
        "numpy": ">=1.20.0"
    }
}